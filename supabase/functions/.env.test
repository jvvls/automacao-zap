# Valores falsos para o teste integrado do webhook (tests/integration).
# Servir com: npx supabase functions serve --env-file supabase/functions/.env.test
# WHATSAPP_GRAPH_URL aponta para o servidor falso que o teste sobe no host.
WHATSAPP_ACCESS_TOKEN=test-access-token
WHATSAPP_PHONE_NUMBER_ID=100000000000001
WHATSAPP_VERIFY_TOKEN=test-verify-token
WHATSAPP_APP_SECRET=test-app-secret
OWNER_WHATSAPP_NUMBER=5511900000000
WHATSAPP_GRAPH_URL=http://host.docker.internal:54400
