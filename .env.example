# Painel (apps/admin/.env.local). A chave pública pode ir ao navegador;
# a proteção dos dados vem das políticas RLS.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Edge Functions: em produção, `supabase secrets set`; no local,
# supabase/functions/.env (não versionado). Nunca expor ao frontend.
# SUPABASE_URL e a credencial de serviço já vêm do ambiente das funções.
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_APP_SECRET=
OWNER_WHATSAPP_NUMBER=
MELHORENVIO_ACCESS_TOKEN=
STORE_POSTAL_CODE=
